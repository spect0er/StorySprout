# ==========================================
# StorySprout Environment Variables Example
# ==========================================
# For Vercel: Add these in your Vercel Dashboard -> Project Settings -> Environment Variables.

# --- Database & Auth ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/StorySprout?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# --- AI (Cohere) ---
COHERE_API_KEY=your_cohere_api_key_here

# --- Firebase Admin (for Server-side Google Auth token verification) ---
FIREBASE_PROJECT_ID=storysprout-f8d5f
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@storysprout-f8d5f.iam.gserviceaccount.com
# Paste the private key including the BEGIN and END lines. In Vercel, newlines can be literal or \n.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...=\n-----END PRIVATE KEY-----\n"

# --- Email Notifications (Nodemailer Gmail) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# --- Frontend API Base URL (Optional) ---
# If deploying both frontend & serverless API to Vercel (monorepo), LEAVE THIS EMPTY.
# If hosting the backend separately (e.g. on Render or Railway), set this to your backend URL:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
VITE_API_BASE_URL=
